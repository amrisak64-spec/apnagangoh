rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Admin check via Firestore
    function isAdmin() {
      return request.auth != null
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Listing images use listings/{ownerId}/{fileName}; public URLs remain readable.
    match /listings/{uid}/{fileName} {
      allow read: if true;

      // Only the signed-in folder owner can upload/replace photos (images only, max 2 MB).
      allow create, update: if request.auth != null
                  && request.auth.uid == uid
                  && request.resource != null
                  && request.resource.contentType.matches('image/.*')
                  && request.resource.size <= 2 * 1024 * 1024;

      // The owner removes their listing photos; admin cleanup remains available for moderation.
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
